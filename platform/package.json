{
  "name": "digital-marshal-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Digital Marshal: interactive digital twin of a synthetic Dubai-inspired district with a deterministic traffic simulation and an incident coordination core. Student research prototype, not an RTA system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiments": "tsx scripts/run-experiments.ts",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright-core": "^1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
